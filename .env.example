# Copy this file to .env and change the values for your machine.
# On this PC PostgreSQL 17 runs on port 5433 (5432 is used by Docker).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shop_learning

# true = print every SQL query that Sequelize runs (very useful while learning!)
SHOW_SQL=false
